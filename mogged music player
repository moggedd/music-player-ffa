-- ===== audio =====
local downloading = {}

local function fetchAsset(option)
    local hasFile = false
    pcall(function() hasFile = _isfile(option.file) end)

    if not hasFile then
        local data
        pcall(function() data = game:HttpGet(option.url) end)
        if (not data or #data == 0) and _request then
            pcall(function()
                local res = _request({Url = option.url, Method = "GET"})
                if res then data = res.Body or res.body end
            end)
        end
        if not data or #data == 0 or not _writefile then return nil end
        local ok = pcall(function() _writefile(option.file, data) end)
        if not ok then return nil end
    end

    local ok, asset = pcall(function() return _getasset(option.file) end)
    if ok and asset then
        assetCache[option.file] = asset
        return asset
    end
    return nil
end

local function getAsset(option)
    if assetCache[option.file] then return assetCache[option.file] end
    if not _getasset then return nil end
    -- already being downloaded (background preload): wait for it, don't download twice
    if downloading[option.file] then
        local t0 = tick()
        while downloading[option.file] and tick() - t0 < 30 do task.wait(0.03) end
        return assetCache[option.file]
    end
    downloading[option.file] = true
    local asset = fetchAsset(option)
    downloading[option.file] = nil
    return asset
end

local function killSound()
    token = token + 1
    if sound then
        pcall(function() sound:Stop() end)
        pcall(function() sound:Destroy() end)
        sound = nil
    end
end

local playSong

local function stopAll()
    killSound()
    playing = false
    statusText = "Stopped"
    refresh()
end

playSong = function(idx)
    songIdx = idx
    killSound()
    local my = token
    playing = true
    statusText = "Loading..."
    refresh()

    task.spawn(function()
        local asset = getAsset(SONGS[idx])
        if my ~= token then return end
        if not asset then
            playing = false
            statusText = "Could not load (needs writefile + getcustomasset)"
            refresh()
            return
        end

        local s = Instance.new("Sound")
        s.Name = "MogMusic"
        s.Volume = volPct / 100
        s.Looped = false
        s.SoundId = asset
        s.Parent = SoundService
        sound = s

        local t0 = tick()
        while s.Parent and not s.IsLoaded and tick() - t0 < 15 do
            task.wait(0.02)
        end
        if my ~= token then
            pcall(function() s:Destroy() end)
            return
        end
        if not s.IsLoaded then
            killSound()
            playing = false
            statusText = "Could not load"
            refresh()
            return
        end

        s:Play()
        statusText = "Now Playing"
        refresh()

        -- when a song ends, roll into the next one
        s.Ended:Connect(function()
            if my == token then
                local nextIdx = songIdx % #SONGS + 1
                playSong(nextIdx)
                scrollToSelected()
            end
        end)
    end)
end

