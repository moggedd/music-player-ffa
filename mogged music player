-- UI scale: 0.05 per click (0.50 - 1.50)
local function setUIScale(v)
    uiScaleVal = math.clamp(round2(v), 0.5, 1.5)
    scaleVal.Text = string.format("%.2f", uiScaleVal)
    TweenService:Create(mainScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {Scale = targetScale()}):Play()
end
