-- ===== helpers =====
local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r
    c.Parent = parent
    return c
end

local function stroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thick or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function makeButton(parent, text, size, pos, bg, textColor, textSize)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = bg
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Text = text
    b.TextColor3 = textColor
    b.Font = Enum.Font.GothamBlack
    b.TextSize = textSize or 13
    b.Parent = parent
    return b
end

local function makeLabel(parent, text, size, pos, font, textSize, color, align)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.Font = font
    l.TextSize = textSize
    l.TextColor3 = color
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function hover(btn, base, over)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = over}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = base}):Play()
    end)
end

local function round2(x)
    return math.floor(x * 100 + 0.5) / 100
end

-- drag anything; onTap fires only if the pointer didn't move (a real click)
local function makeDraggable(obj, onTap)
    local dragging, moved = false, false
    local startMouse, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            startMouse = input.Position
            startPos = obj.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    local wasDragging = dragging
                    dragging = false
                    if wasDragging and not moved and onTap then onTap() end
                end
            end)
        end
    end)
    table.insert(conns, UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startMouse
            if d.Magnitude > 4 then moved = true end
            if moved then
                obj.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end))
end

